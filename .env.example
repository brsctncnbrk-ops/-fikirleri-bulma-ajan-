# --- Zorunlu (sistemin beyni ve arayüzü) ---
# Anthropic Claude API anahtarı. Edinme: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Telegram bot token. Edinme: Telegram'da @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Raporun gönderileceği sohbet/kanal id'si (kendine /start yazıp id'ni öğren)
TELEGRAM_CHAT_ID=

# --- Opsiyonel kaynaklar (yoksa ilgili tarayıcı atlanır) ---
# Reddit: https://www.reddit.com/prefs/apps → "create app" (script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trendidea/0.1 by u/yourname

# Product Hunt: https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# --- Model ayarları (varsayılanlar yeterli) ---
LLM_MODEL_REASONING=claude-sonnet-4-6
LLM_MODEL_CHEAP=claude-haiku-4-5
# Token fiyatı (USD / 1M token). Boş/0 = maliyet tahmini gösterilmez (fiyat uydurulmaz).
# Güncel fiyatları planından doğrulayıp gir.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# RSS/Atom besleme URL'leri (virgülle ayır; boş = yerleşik varsayılan liste)
RSS_FEEDS=

# --- Çalışma ayarları ---
# Günlük rapor saati (24s, sistem saat dilimi: TIMEZONE)
DAILY_REPORT_HOUR=9
TIMEZONE=Europe/Istanbul
# Taranacak zaman penceresi (saat)
SCAN_WINDOW_HOURS=72
# SQLite veritabanı yolu
DATABASE_PATH=trendidea.db
LOG_LEVEL=INFO
